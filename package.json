{
 "name": "gotham-night-is-listening",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "scripts": {
  "dev": "vite",
  "build": "tsc --noEmit && tsc -p server --noEmit && vite build",
  "preview": "vite preview",
  "test": "vitest run",
  "server": "tsx server/server.ts",
  "dev:full": "concurrently -k -n web,api \"npm:dev\" \"npm:server\"",
  "start": "vite build && tsx server/server.ts"
 },
 "dependencies": {
  "@fontsource/anton": "^5.3.0",
  "@fontsource/barlow-condensed": "^5.3.0",
  "@fontsource/inter": "^5.3.0",
  "better-sqlite3": "^13.0.3",
  "motion": "^14.3.0",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "tsx": "^4.23.15"
 },
 "devDependencies": {
  "@types/better-sqlite3": "^9.6.0",
  "@types/node": "^26.6.5",
  "@types/react": "^18.3.3",
  "@types/react-dom": "^18.3.0",
  "@vitejs/plugin-react": "^4.3.1",
  "concurrently": "^10.0.6",
  "typescript": "^5.5.4",
  "vite": "^5.4.0",
  "vitest": "^2.1.9"
 }
}